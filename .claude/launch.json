{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["storybook", "dev", "-p", "6006", "--no-open"],
      "port": 6006,
      "cwd": "apps/storybook-web"
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "3000"],
      "port": 3000,
      "cwd": "apps/web-preview"
    },
    {
      "name": "playground",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "port": 8081,
      "cwd": "apps/playground"
    },
    {
      "name": "storybook-rn",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--port", "8082"],
      "port": 8082,
      "cwd": "apps/storybook"
    }
  ]
}
